<?xml version="1.0"?>
<package format="3">
  <name>kestrel_msgs</name>
  <version>0.1.0</version>
  <description>Custom messages, services, and actions for the Kestrel Drone</description>
  <maintainer email="da364739@ucf.edu">David Orjuela</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>
  <build_depend>geometry_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <build_depend>vision_msgs</build_depend>
  <exec_depend>vision_msgs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>